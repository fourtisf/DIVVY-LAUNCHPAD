# Peers are declared explicitly; auto-install would pull react-native in via the mobile wallet adapter.
auto-install-peers=false
strict-peer-dependencies=false
# The API and the worker bundle packages/db into dist/ and load @prisma/client at run time from their
# own folders. Hoisting Prisma to the root node_modules lets them find the one generated client.
public-hoist-pattern[]=*prisma*
