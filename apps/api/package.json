    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "ioredis": "^5.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.1.0",
    "@divvy/solana": "workspace:*",
    "bs58": "^6.0.0",
    "bullmq": "^6.4.2",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@fastify/rate-limit": "^11.2.1",
    "@solana/web3.js": "^1.99.0",
    "bn.js": "^5.2.2",
    "@divvy/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
