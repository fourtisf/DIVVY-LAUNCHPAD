# Copy to .env at the repo root. Never commit real values.

# --- database / cache ---
DATABASE_URL=postgresql://divvy:divvy@localhost:5432/divvy?schema=public
REDIS_URL=redis://localhost:6379

# --- api ---
API_PORT=4000
API_HOST=127.0.0.1
# Mock mode serves deterministic demo data (Phase 1). Refuses to start with NODE_ENV=production.
API_MODE=mock
SESSION_SECRET=change-me-32-bytes-minimum-change-me
WEB_ORIGIN=http://localhost:3000

# --- web ---
# Where Next.js proxies /api/* (server side and rewrites).
API_INTERNAL_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SOLANA_RPC_URL=

# --- solana (Phase 2+; leave empty until approved) ---
SOLANA_RPC_URL=
HELIUS_API_KEY=
JITO_BLOCK_ENGINE_URL=
JUP_API_KEY=
# Paths to keypair files readable only by the service user. Never put key material here.
LAUNCHER_KEYPAIR_PATH=
PAYOUT_VAULT_KEYPAIR_PATH=
FEE_CLAIMER_KEYPAIR_PATH=

# --- worker ---
PAYOUTS_DRY_RUN=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
