# Development: copy to .env at the repo root. Never commit real values. Empty means "not set": the default applies.
# Production splits this file per app, each chmod 600 and owned by that app's user (deploy/setup-vps.md):
#   /etc/divvy/web.env, /etc/divvy/api.env, /etc/divvy/worker.env. Each section says where it goes.
#   Only worker.env names keypair files; the API and the web never see a key.

# --- database / cache [api, worker] ---
DATABASE_URL=postgresql://divvy:divvy@localhost:5432/divvy?schema=public
REDIS_URL=redis://localhost:6379

# --- api [api] ---
API_PORT=4000
API_HOST=127.0.0.1
# mock: deterministic demo data, no chain, no database (refuses NODE_ENV=production).
# live: Postgres + Redis + Solana. Needs the solana block below.
API_MODE=mock
# The site origin. The web reads it too (link previews), so it also goes in web.env.
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Header carrying the visitor's ISO country code (set by Nginx GeoIP2 or Cloudflare; deploy/nginx/divvy.conf).
GEO_HEADER=x-geo-country
# Launch wallets must be at least this old (first transaction), on top of LAUNCH_MIN_WALLET_LAMPORTS.
LAUNCH_MIN_WALLET_AGE_DAYS=3
# Jupiter key for the API's quotes, so the worker's key and rate limit stay separate. Falls back to JUP_API_KEY.
JUP_API_KEY_API=

# --- X (Twitter) OAuth 2.0, confidential client. Leave empty to hide "Link X". [api] ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
# Defaults from X's official SDK (docs/VERIFIED.md).
X_AUTHORIZE_URL=
X_API_BASE=

# --- media and token metadata storage [api, worker] ---
# local: files under STORAGE_DIR served at /api/media/files/*. s3: any S3-compatible bucket.
# Token metadata URIs are permanent once a coin exists: production needs durable storage (owner decision).
# With NODE_ENV=production both apps refuse to start unless STORAGE_DIR is absolute and outside the
# release (e.g. /var/lib/divvy/media) and PUBLIC_MEDIA_BASE is a public https URL.
STORAGE_DRIVER=local
STORAGE_DIR=./data/media
PUBLIC_MEDIA_BASE=http://localhost:3000/api/media/files
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- web [web; NEXT_PUBLIC_* are baked in at build time, so the build needs them too] ---
# Where Next.js proxies /api/* (server side and rewrites).
API_INTERNAL_URL=http://127.0.0.1:4000
# Browser RPC for wallet sends (a public-facing, rate-limited endpoint; never the worker's private RPC).
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# The terms page shows a draft notice until legal review approves the text (owner decision).
NEXT_PUBLIC_TERMS_FINAL=false
# The uspad token's contract address, shown in the hero with a copy button. Empty shows "CA: coming soon".
NEXT_PUBLIC_TOKEN_CA=

# --- solana [api, worker] ---
# devnet until the audit sign-off and the owner's approval (docs/MAINNET_CHECKLIST.md).
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=
SOLANA_WS_URL=
# Divvy's PlatformConfig, created once with the owner's approval (packages/solana/scripts/phase0).
DIVVY_PLATFORM_CONFIG=
# Defaults to the SDK's LAUNCHPAD_CONFIG for the cluster.
LAUNCHLAB_GLOBAL_CONFIG=
JITO_BLOCK_ENGINE_URL=
JITO_UUID=
JITO_TIP_LAMPORTS=100000
JUP_BASE_URL=https://api.jup.ag
JUP_API_KEY=
# The mainnet gate. Nothing is signed and sent on mainnet unless this is "true".
# Set it only after docs/MAINNET_CHECKLIST.md is complete and signed off.
DIVVY_MAINNET_ENABLED=false

# Hot-wallet keypair files (solana-keygen JSON, chmod 400, owned by divvy-worker, outside the repo).
# Never key material here. Each worker role loads only the key it needs. [worker only]
LAUNCHER_KEYPAIR_PATH=
PAYOUT_VAULT_KEYPAIR_PATH=
FEE_CLAIMER_KEYPAIR_PATH=

# --- business parameters [api, worker: keep both files identical] ---
# Must match the on-chain PlatformConfig; payouts refuse to run if they don't.
FEE_TRADE_BPS=100
FEE_PROTOCOL_BPS=25
FEE_HOLDERS_BPS=50
FEE_CREATOR_BPS=15
FEE_DIVVY_BPS=10
# push: paid every hour. claim: credited every hour, holders claim (HANDOFF §3.4; owner decision, copy follows).
PAYOUT_DELIVERY=push
# Dry-run computes every round and sends nothing (CLAUDE.md rule 7). Run it first.
PAYOUTS_DRY_RUN=true
MIN_ROUND_USD=5
MIN_HOLDER_USD=10
AUTO_PUSH_MIN_USD=1
# uspad's fee per automatic send, kept from the dividend in stock; a first send also keeps the new account's rent.
DELIVERY_FEE_USD=0.02
LATE_AFTER_SEC=900
MAX_SWAP_IMPACT_BPS=300
SWAP_SLIPPAGE_BPS=100
LAUNCHES_PER_WALLET_PER_DAY=3
LAUNCHES_PER_DAY_GLOBAL=2000
LAUNCH_COOLDOWN_SEC=120
LAUNCH_MIN_WALLET_LAMPORTS=50000000
LAUNCHER_HOURLY_CAP_LAMPORTS=3000000000
# ISO country codes that can't launch or claim (owner + legal decision).
BLOCKED_COUNTRIES=US
ADMIN_WALLETS=

# --- worker [worker] ---
# Comma-separated: launch,claims,indexer,payouts,prices,status,reserved
WORKER_ROLES=launch,claims,indexer,payouts,prices,status,reserved
HOT_WALLET_MIN_SOL=0.5
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
HOLDERS_VIA_DAS=true
INDEXER_POLL_MS=4000
# Push model: create a holder's token account only once the credit is worth this much (docs/ECONOMICS.md).
PUSH_NEW_ATA_MIN_USD=5
PUSH_BATCH_SIZE=6
# Collect CPMM creator fees of graduated coins (needs platform_cp_creator = fee claimer; owner approval).
CPMM_CREATOR_FEES=false
# Collect graduated coins' locked-LP fees with the Fee Key (platform_lock_nft_wallet = fee claimer).
# Off: every run simulates and logs what it would collect. Turn on after the first graduated coin's log looks right.
LOCKED_LP_FEES=false
# Forward a creator's share of post-graduation fees once it reaches this many lamports (0.01 SOL).
CREATOR_FORWARD_MIN_LAMPORTS=10000000
CU_PRICE_MICRO_LAMPORTS=20000
# Spend caps per hour: SOL the payout engine may swap into stocks (100 SOL), and USD of stock it may
# push to holders. Over a cap, part goes now and the rest waits for a later hour (docs/RUNBOOK.md "Spend caps").
SWAP_HOURLY_CAP_LAMPORTS=100000000000
PUSH_HOURLY_CAP_USD=25000
# Largest swap per stock per hour (20 SOL). Halves after a swap is refused for price impact, grows back after good ones.
SWAP_BATCH_MAX_LAMPORTS=20000000000

# --- backups (deploy/backup/pg-backup.sh) [backup] ---
RCLONE_REMOTE=
